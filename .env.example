# API REST
PORT=3000
API_PREFIX=/api/v1

# MariaDB local
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=gestion_monitorias_tutorias
DATABASE_USER=tutorias_app
DATABASE_PASSWORD=

# Solo se usa en el primer arranque si la base todavía no existe.
# Debe ser una cuenta administrativa de MariaDB.
DATABASE_BOOTSTRAP_USER=root
DATABASE_BOOTSTRAP_PASSWORD=

# Frontend
VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_NAME=Gestión de Tutorías y Monitorías

# API / autenticación
# En desarrollo puede quedar vacío; en producción configura una clave aleatoria de al menos 32 caracteres.
JWT_SECRET=
ACCESS_TOKEN_TTL=8h
PRE_AUTH_TOKEN_TTL=5m
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Docker Compose (independientes de la conexión a MariaDB local)
# Completar ambas contraseñas y JWT_SECRET antes de ejecutar Compose.
DOCKER_DATABASE_PASSWORD=
DOCKER_DATABASE_ROOT_PASSWORD=
DOCKER_WEB_PORT=5173
# Desarrollo permite migrar las claves heredadas de las cuentas demo a bcrypt.
DOCKER_NODE_ENV=development
DOCKER_CORS_ORIGIN=http://localhost:5173
