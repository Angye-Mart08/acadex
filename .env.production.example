# Copia como .env en el servidor. No subir este archivo con valores secretos.
DOCKER_DATABASE_PASSWORD=
DOCKER_DATABASE_ROOT_PASSWORD=
JWT_SECRET=

# Dominio y certificado HTTPS (registro DNS A/AAAA dirigido a la IP del VPS)
ACADEX_DOMAIN=acadex.example.com
ACADEX_TLS_EMAIL=admin@example.com
PUBLIC_ORIGIN=https://acadex.example.com

# Gmail de pruebas / correo SMTP autorizado
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=acadexmytsistemas@gmail.com
SMTP_PASSWORD=
SMTP_FROM=acadexmytsistemas@gmail.com
